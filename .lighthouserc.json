{
  "ci": {
    "collect": {
      "url": ["http://127.0.0.1:4173/"],
      "startServerCommand": "corepack pnpm exec vite preview --host 127.0.0.1 --port 4173 --strictPort",
      "startServerReadyPattern": "Local:.*4173",
      "startServerReadyTimeout": 10000,
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci_reports",
      "reportFilenamePattern": "lighthouse-%s-%s.html"
    }
  }
}
