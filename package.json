{
  "name": "stillpoint-recovery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/generate-theme-assets.mjs && concurrently -k -n API,WEB \"APP_API_PORT=3001 node server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "node scripts/generate-theme-assets.mjs && tsc -b && vite build && node scripts/create-precache-manifest.mjs",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "check:coverage": "node scripts/check-coverage-summary.mjs",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "check:server": "node --check server/index.mjs && node --check server/app.mjs && node --check server/serverless.mjs && node --check server/community-router.mjs && node --check server/community-policy.mjs && node --check server/database.mjs && node --check netlify/functions/community.mjs && node --check api/community.mjs && node --check server/db-config.mjs",
    "db:migrate": "node scripts/migrate-community.mjs",
    "test:coverage": "vitest run --coverage",
    "verify:pwa": "node scripts/check-pwa-artifact.mjs"
  },
  "dependencies": {
    "dexie": "4.0.10",
    "dexie-react-hooks": "1.1.7",
    "express": "5.3.0",
    "framer-motion": "11.15.0",
    "leaflet": "1.9.4",
    "lucide-react": "0.468.0",
    "mysql2": "3.24.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.1",
    "serverless-http": "3.2.0",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.128.0",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "5.1.0",
    "autoprefixer": "10.4.20",
    "axe-core": "4.10.2",
    "concurrently": "10.0.6",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "fake-indexeddb": "6.0.0",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vite": "6.4.5",
    "vitest": "5.1.0"
  }
}
