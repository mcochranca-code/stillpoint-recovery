{
  "name": "stillpoint-recovery",
  "version": "1.0.0",
  "description": "A local-first, installable recovery companion.",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "public/",
    "scripts/",
    "index.html",
    "app.config.ts",
    "postcss.config.js",
    "tailwind.config.ts",
    "tsconfig*.json",
    "vite.config.ts",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcochranca-code/stillpoint-recovery.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/create-precache-manifest.mjs",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "preview": "vite preview",
    "verify:pwa": "node scripts/check-pwa-artifact.mjs"
  },
  "dependencies": {
    "dexie": "4.0.10",
    "dexie-react-hooks": "1.1.7",
    "framer-motion": "11.15.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "fake-indexeddb": "6.0.0",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vite": "6.4.4",
    "vitest": "3.2.6"
  }
}
